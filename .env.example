# Copy this file to .env and fill in your Facebook credentials.
# Get a Page access token from https://developers.facebook.com/tools/explorer/
# Required permissions: pages_read_engagement, read_insights, pages_show_list

FB_PAGE_ID=your_page_id_here
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Graph API version to use
FB_API_VERSION=v21.0

# Set to "true" to force demo mode (sample data, no API calls)
DEMO_MODE=false
